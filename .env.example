# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.

# Ollama inference engine URL (used by the backend container)
OLLAMA_HOST=http://ollama:11434

# Ollama response timeout in seconds (increase for large/slow models)
OLLAMA_TIMEOUT=120

# Backend service URL (used by the frontend container)
BACKEND_HOST=http://backend:8000

# Set to true to enable FastAPI debug mode and verbose Python tracebacks
DEBUG=false

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
